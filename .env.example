# Public Supabase project settings (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported if your project still uses it:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact trusted API provider domains for API Studio execution.
# Example: api.example.com,api.partner.example
CYBERX_API_ALLOWED_HOSTS=

# Optional provider credentials — add only when enabling each integration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
RAILWAY_API_TOKEN=
RENDER_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
INTEGRATION_ENCRYPTION_KEY=

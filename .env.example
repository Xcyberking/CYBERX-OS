# Public Supabase project settings (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is supported if your project still uses it:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact trusted API provider domains for API Studio execution.
CYBERX_API_ALLOWED_HOSTS=

# GitHub OAuth App — server-side only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Exact callback URL configured in the GitHub OAuth App:
GITHUB_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/github/callback
# Generate a 32-byte key with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Other provider credentials — not used by this GitHub-only release yet.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
RAILWAY_API_TOKEN=
RENDER_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google OAuth for Firebase Developer Hub (Firebase read-only scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact callback URL configured in your Google OAuth web client:
GOOGLE_REDIRECT_URI=https://YOUR_DOMAIN/api/integrations/firebase/callback
